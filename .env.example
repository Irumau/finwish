# --- Base de datos y colas (coinciden con docker/docker-compose.yml) ---
DATABASE_URL=postgresql://finwish:finwish@localhost:5432/finwish
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- SSO ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Proveedores externos (worker) ---
SERPAPI_KEY=
EXCHANGE_RATE_API_KEY=
